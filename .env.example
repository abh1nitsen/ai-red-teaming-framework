# .env.example
# Copy this file to .env and fill in your values.
# In Google Colab: use Colab Secrets (the key icon in the left sidebar) instead.
#
# The framework requires only one API key.
# Get it free from: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Optional: override which models are used (otherwise config.yaml is used)
# TARGET_MODEL=openai/gpt-oss-20b
# JUDGE_MODEL=openai/gpt-oss-120b
